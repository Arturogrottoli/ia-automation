<mxfile host="app.diagrams.net">
  <diagram id="bot-peliculas" name="Bot de películas">
    <mxGraphModel dx="1200" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1180" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Título -->
        <mxCell id="title" value="Bot de películas: flujo para registrar o consultar una peli" style="text;html=1;fontSize=20;fontStyle=1;fontColor=#260700;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="700" height="40" as="geometry" />
        </mxCell>

        <!-- Etiquetas de rol -->
        <mxCell id="tag-trigger" value="TRIGGER" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#FF632B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="170" width="170" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tag-ia" value="ACCIÓN (IA)" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#FF632B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="270" y="170" width="170" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tag-decision" value="DECISIÓN" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#FF632B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="455" y="160" width="130" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tag-acciones" value="ACCIONES" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#FF632B;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="95" width="180" height="20" as="geometry" />
        </mxCell>
        <mxCell id="tag-output" value="FIN / OUTPUT" style="text;html=1;fontSize=11;fontStyle=1;fontColor=#FF632B;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1075" y="170" width="100" height="20" as="geometry" />
        </mxCell>

        <!-- Nodos -->
        <mxCell id="n-trigger" value="Llega un mensaje por Telegram" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF632B;strokeWidth=2;fontColor=#260700;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n-ia" value="La IA interpreta el mensaje y arma la ficha (director, año, país, género)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#260700;strokeWidth=2;fontColor=#260700;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="270" y="195" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="n-decision" value="¿Quiere registrar una peli?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF4EA;strokeColor=#FE872D;strokeWidth=2;fontColor=#260700;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="n-si" value="Guardar la fila en Google Sheets" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#260700;strokeWidth=2;fontColor=#260700;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="120" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-no" value="Buscar en el catálogo y responder la consulta" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#260700;strokeWidth=2;fontColor=#260700;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="760" y="290" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n-fin" value="Respuesta enviada por Telegram" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FF632B;strokeWidth=2;fontColor=#260700;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="990" y="200" width="170" height="80" as="geometry" />
        </mxCell>

        <!-- Flechas -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#260700;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n-trigger" target="n-ia">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#260700;strokeWidth=1.5;endArrow=block;endFill=1;" edge="1" parent="1" source="n-ia" target="n-decision">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-si" value="Sí" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#260700;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1;fontColor=#FF632B;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n-decision" target="n-si">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-no" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#260700;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=12;fontStyle=1;fontColor=#FE64A3;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n-decision" target="n-no">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-si-fin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#260700;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-si" target="n-fin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-no-fin" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#260700;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n-no" target="n-fin">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Referencias Trigger / Input / Output -->
        <mxCell id="leyenda" value="&lt;b&gt;Trigger:&lt;/b&gt; mensaje nuevo en Telegram&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Input:&lt;/b&gt; el texto del mensaje (nombre de la peli o una pregunta)&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Output:&lt;/b&gt; respuesta enviada por Telegram&lt;br&gt;&lt;i&gt;El output de la IA (la ficha) es el input de la decisión y de la fila en Google Sheets.&lt;/i&gt;" style="text;html=1;whiteSpace=wrap;fontSize=13;fontColor=#3D3430;align=left;verticalAlign=middle;fillColor=#F8F2E8;strokeColor=#E5DCD0;spacingLeft=12;rounded=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="410" width="1120" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
