    {
      "parameters": {
        "jsCode": "// Hace lo mismo que el WhatsApp Trigger: Meta manda un paquete con \"entry\" y \"changes\",\n// y el trigger entrega solo la parte \"value\" de cada cambio (contactos, mensajes, etc.).\nconst body = $input.first().json.body;\nconst salida = [];\nfor (const entry of body.entry ?? []) {\n  for (const change of entry.changes ?? []) {\n    // Igual que el trigger con \"Receive Message Status Updates\" vacío:\n    // los avisos de entregado/leído no pasan.\n    if (change.value?.statuses) continue;\n    salida.push({ json: { ...change.value, field: change.field } });\n  }\n}\nreturn salida;"
      },
      "id": "080919bc-1182-450d-b968-78a6ca076715",
      "name": "Como lo entrega el WhatsApp Trigger",
